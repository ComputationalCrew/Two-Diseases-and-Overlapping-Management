set.seed(123)


m_xgboost <- function(nthread = 1,
                      ntrees = 1000,
                      shrinkage = 0.3,
                      max_depth = 5,
                      ...) {SuperLearner::SL.xgboost(
                        nthread = nthread,
                        ntrees = ntrees,
                        shrinkage=shrinkage,
                        max_depth=max_depth,
                        ...)}


data_with_gps <- estimate_gps(.data = df_v1,
                              .formula = Seasonal_powdery_mildew_incidence ~ Susceptibility_to_V6_Strains + Susceptibility_to_non_V6_Strains +
                                Initial_strain + Pruning +  Annual_costs_for_both + 
                                Quadrant_NE + Quadrant_NW + Quadrant_SE + Quadrant_SW + 
                                Group + Powdery_mildew_incidence_April +
                                Powdery_mildew_incidence_May + Powdery_mildew_incidence_June + 
                                Powdery_mildew_incidence_July,
                              sl_lib = c("m_xgboost"),
                              gps_density = "kernel")



cw_object_matching <- compute_counter_weight(gps_obj = data_with_gps,
                                             ci_appr = "weighting",
                                             bin_seq = NULL, 
                                             delta_n = 0.1,
                                             dist_measure = "l1",
                                             scale = 0.5,
                                             use_cov_transform = TRUE,
                                             transformers = list("pow2", "pow3", "abs", 
                                                                 "scale"),
                                             exposure_trim_qtls = c(0.01,0.99),
                                             sl_lib = c("m_xgboost"),
                                             max_attempt = 4,
                                             dist_measure = "l1",
                                             delta_n = 0.02,          # changed from 1 to 0.02
                                             scale = 0.5,
                                             nthread = 1)


pseudo_pop <- generate_pseudo_pop(.data = df_v1,
                                  cw_obj = cw_object_matching,
                                  covariate_col_names = c('Susceptibility_to_V6_Strains','Susceptibility_to_non_V6_Strains',
                                                          'Initial_strain','Pruning','Annual_costs_for_both',
                                                          'Quadrant_NE','Quadrant_NW','Quadrant_SE','Quadrant_SW',
                                                          'Group','Powdery_mildew_incidence_April',
                                                          'Powdery_mildew_incidence_May','Powdery_mildew_incidence_June',
                                                          'Powdery_mildew_incidence_July'),
                                  covar_bl_trs = 0.3,
                                  covar_bl_trs_type = "median",
                                  covar_bl_method = "absolute")

# Supplementary Figure 3
png("pseudo_pop_downy0_costs.png", width=6000,height=7000, res=1000)
plot(pseudo_pop, include_details = TRUE) + theme(panel.grid.major = element_blank(), panel.grid.minor = element_blank(),
                                                 panel.background = element_blank(), axis.line = element_line(colour = "black")) 
dev.off()


# ERF
# Annual costs
erf_obj_nonparametric <- estimate_erf(.data = pseudo_pop$.data,
                                      .formula = Annual_costs_for_powdery_only_both ~ Seasonal_powdery_mildew_incidence,
                                      weights_col_name = "counter_weight",
                                      model_type = "nonparametric",
                                      w_vals = seq(0,0.6,0.01),
                                      bw_seq = seq(0.2,2,0.2),
                                      kernel_appr = "kernsmooth")


erf_obj_nonparametric[[".data_prediction"]][["w_vals"]]

erf_obj_nonparametric[[".data_prediction"]][["y_pred"]]

