df <- read.csv(".../2014 to 2017 Oregon Pesticide Use Record Database_04132026_v9.csv", check.names=FALSE)

# remove 2018 year
df <- df %>%
  filter(!Year %in% c("2018"))

# Only use fungicide
df_fun_her <- subset(df, Type == "Fungicide")


# remove the following active ingredients
df_fun_her <- df_fun_her %>%
  filter(!Active %in% c("Clethodim", "Clopyralid","Dimethenamid-P",
                        "Glyphosate", "Pendimethalin","Norflurazon"))

df_fun_her$formatted_name <- sprintf("%s%s", df_fun_her$Year, df_fun_her$`Field ID`)

# remove no lattitude and longitude
df_fun_her <- df_fun_her[!(df_fun_her$Name == "20148"), ]

# remove no pruning information
df_fun_her <- df_fun_her[!(df_fun_her$Pruning == "."), ]


# Specify the column to one-hot encode (Powdery)
target_col <- "Powdery"

# Ensure the column is a factor
df_fun_her[[target_col]] <- as.factor(df_fun_her[[target_col]])

# Perform one-hot encoding for the specific column
one_hot <- model.matrix(~ . - 1, data = df_fun_her[target_col]) %>% as.data.frame()

df_fun_her <- cbind(df_fun_her, one_hot)


