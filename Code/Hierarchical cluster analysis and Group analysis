df <- read.csv(".../2014 to 2017 Oregon Pesticide Use Record Database_04132026.csv", check.names=FALSE)

df <- df %>%
  filter(!Year %in% c("2018"))

df_fun_her <- subset(df, Type == "Fungicide" | Type == "Herbicide")

df_fun_her <- df_fun_her %>%
  filter(!Active %in% c("Clethodim", "Clopyralid","Dimethenamid-P", 
                        "Glyphosate", "Pendimethalin","Norflurazon"))

df_fun_her$formatted_name <- sprintf("%s%s", df_fun_her$Year, df_fun_her$`Field ID`)


#find count by formatted_name, Active
data_type <- df_fun_her %>%
  group_by(formatted_name, Active) %>% 
  summarize(sum_Type = n())


# reshape the data from long to wide
data_type <- cast(data_type , Active ~ formatted_name)

# Replace all NA values with 0
data_type[is.na(data_type)] <- 0

scaled_type <- scale(data_type)

Type <- read.csv(".../type.csv", row.names="Model")

# Figure 1
png("silhouettetype.png",width=15,height=12,units="cm" , res = 1000)
fviz_nbclust(scaled_type, FUNcluster = hcut, method = c("silhouette"))
dev.off()

# Figure 2
png("pheatmaptype.png",width=40,height=20,units="cm" , res = 1000)
clustered_data <- pheatmap(scaled_type, 
                           name = "Number of active ingredients used",
                           main = "     Number of active ingredients used",
                           cluster_rows = T, cluster_cols = T, cutree_col = 3,
                           display_numbers = F,
                           annotation_row = Type,
