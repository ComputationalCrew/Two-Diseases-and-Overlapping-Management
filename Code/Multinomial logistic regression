# Read the dataset and convert the target variable to a factor
MLR_SB <- read.csv(".../downy_mildew_fungicide_record_database_SB_V10_Multinomial.csv", check.names=FALSE)

# Table 1. Descriptive Statistics
stargazer(MLR_SB, type = "text", title="Descriptive statistics", digits=2, out="table1.txt")

levels(factor(MLR_SB$group))

library(vtable)
st(MLR_SB, group = 'group', group.test = TRUE)
st(MLR_SB, group = 'group', group.long = TRUE)


for (i in 1:12) {
MLR_SB[i] <- scale(MLR_SB[i])
}


MLR_SB$group <- as.factor(MLR_SB$group)
MLR_SB$pruning <- as.factor(MLR_SB$pruning)
MLR_SB$susceptibility.to.r6.Strains <- as.factor(MLR_SB$susceptibility.to.r6.Strains)
MLR_SB$susceptibility.to.nonr6.Strains <- as.factor(MLR_SB$susceptibility.to.nonr6.Strains)
MLR_SB$Downy_mildew_susceptibility <- as.factor(MLR_SB$Downy_mildew_susceptibility)
MLR_SB$year <- as.factor(MLR_SB$year)
MLR_SB$Grower <- as.factor(MLR_SB$Grower)
MLR_SB$spray.date <- as.numeric(MLR_SB$spray.date)

str(MLR_SB)
# check that A is now our reference
levels(MLR_SB$group)


# define reference by ensuring it is the first level of the factor
MLR_SB$group <- relevel(MLR_SB$group, ref = "Downy")

MLR_SB$group <- relevel(MLR_SB$group, ref = "Powdery")

MLR_SB$group <- relevel(MLR_SB$group, ref = "Both")

MLR_SB$group <- relevel(MLR_SB$group, ref = "Mixture")

library(nnet)



# Supp Table 2. Logistic regression result 
multi_model_S <- multinom(formula = group ~ spray.date + first.spray.date + susceptibility.to.r6.Strains + 
                            susceptibility.to.nonr6.Strains + pruning + mildew.incidence + 
                            disease.in.may + Downy_mildew_susceptibility + flagshoot + 
                            year + Grower, data = MLR_SB, na.rm = TRUE)



# Supplementary Table 5
summary(multi_model_S)
exp(coef(multi_model_S))
gtsummary::tbl_regression(multi_model_S, intercept = TRUE)


library(lmtest)
lrtest(multi_model_S)

library(pscl)

#calculate McFadden's R-squared for model
pR2(multi_model_S)['McFadden']


# Variable importance

library(Boruta)

boruta_output <- Boruta(MLR_SB$group ~ spray.date + first.spray.date + susceptibility.to.r6.Strains + 
                          susceptibility.to.nonr6.Strains + pruning + mildew.incidence + 
                          disease.in.may + Downy_mildew_susceptibility + flagshoot + 
                          year + Grower, data = MLR_SB, doTrace = 2
)
boruta_output

rough_fix_mod <- TentativeRoughFix(boruta_output)
boruta_signif <- getSelectedAttributes(rough_fix_mod)
boruta_signif

importances <- attStats(rough_fix_mod)
importances <- importances[importances$decision != "Rejected", c("meanImp", "decision")]
importances[order(-importances$meanImp), ]


